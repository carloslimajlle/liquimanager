# /etc/lqm-runner.env, read by lqm-runner.service. Keep it readable by the service user only (chmod 600).
LQM_URL=https://lqm.example.internal
# A service token with the `runner` and `ingest` scopes.
LQM_TOKEN=lqm_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# A read-only credential in the URL if the repository is private.
LQM_GIT_URL=https://oauth2:READ_ONLY_TOKEN@gitlab.example.internal/core/gate.git
# The account that may revert changesets on the target database.
LQM_DB_USERNAME=lqm_runner
LQM_DB_PASSWORD=change-me
