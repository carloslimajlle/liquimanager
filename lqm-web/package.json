    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-table": "9.3.1",
    "lucide-react": "1.66.0",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "storybook": "10.6.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
