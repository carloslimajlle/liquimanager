{
  "name": "lqm-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SPA do LiquiManager. Alvo visual: docs/prints/mockups/*.png",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
